# Hard-fail if Node is not 22.22.2 (see .nvmrc). jsdom@30 requires
# ^22.22.2 || ^24.15.0 || >=26 — a forgotten `nvm use` would otherwise
# produce a silently broken tree.
engine-strict=true

# Every dependency is pinned exactly. Reproducible builds matter more than
# automatic patch uptake for a stack this tightly coupled.
save-exact=true

fund=false
audit=true
