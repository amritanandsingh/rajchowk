# =============================================================================
# Raj Chowk — copy to `.env.local` (gitignored). NEVER put real secrets here.
#
# Backend secrets are NOT read from this file. They live in:
#   - local sandbox:  npx ampx sandbox secret set <NAME>
#   - deployed branch: Amplify Console -> Hosting -> Secrets
# and are consumed in amplify/ via `secret('NAME')`.
# =============================================================================

# ---- AWS (local dev only; credentials come from ~/.aws/credentials) ---------
AWS_PROFILE=default
AWS_REGION=ap-south-1

# ---- Public site config -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=राज चौक
NEXT_PUBLIC_DEFAULT_LOCALE=hi
NEXT_PUBLIC_AWS_REGION=ap-south-1
# production | staging | development | sandbox
NEXT_PUBLIC_ENV=development

# Optional: only if the media bucket is fronted by a CDN.
# NEXT_PUBLIC_MEDIA_CDN_HOST=media.rajchowk.in
# Fallback if amplify_outputs.json is absent at build time.
# NEXT_PUBLIC_MEDIA_BUCKET=

# ---- E2E / integration test config ------------------------------------------
E2E_BASE_URL=http://localhost:3000
# Port for the Playwright-managed dev/prod server. Both the server and baseURL
# are derived from this, so changing it here is sufficient.
E2E_PORT=3000
# Set to 1 to run the `live` Playwright projects (requires a deployed sandbox).
# E2E_LIVE=1
# Set to 1 to skip Playwright's built-in webServer (e.g. testing staging).
# E2E_NO_SERVER=1
E2E_TEST_PASSWORD=ChangeMe!E2E-2026
E2E_EMAIL_DOMAIN=e2e.rajchowk.test

# ---- Names of the Amplify secrets that must exist per environment -----------
# Set with: npx ampx sandbox secret set RATE_LIMIT_IP_SALT
#           npx ampx sandbox secret set NEWSLETTER_TOKEN_SECRET
# These are listed for documentation only — the values never live in a file.
#   RATE_LIMIT_IP_SALT          HMAC salt for IP hashing (never store raw IPs)
#   NEWSLETTER_TOKEN_SECRET     HMAC secret for unsubscribe-link signing

# ---- SES (identity is created ONCE, manually, outside Amplify) --------------
# NOTE: these are read at CDK SYNTH time, from the shell running `ampx`. They
# are not runtime app config. A developer with a different SES_DOMAIN exported
# will synthesise a divergent stack, so keep this file as the single source.
SES_DOMAIN=rajchowk.in
SES_FROM_ADDRESS=news@rajchowk.in
# Declared for documentation only — nothing in the codebase reads this yet.
SES_REPLY_TO_ADDRESS=hello@rajchowk.in
SES_CONFIGURATION_SET=rajchowk-transactional

# ---- Backend deploy-time toggles (read by amplify/backend.ts at synth) ------
# Origin used to build newsletter verify/unsubscribe links inside the Lambdas.
# Leave unset on main/production (it derives https://$SES_DOMAIN). Set it on a
# non-production branch so emailed links point at THAT branch rather than
# http://localhost:3000, which is the hardcoded off-production fallback.
# SITE_URL=https://2-0-0.<appid>.amplifyapp.com
#
# Set to 1 to give reconcileCounters reserved concurrency (serial execution).
# Currently unset in every environment, including production.
# ENABLE_RESERVED_CONCURRENCY=1
#
# Set to 1 to apply PRODUCTION security hardening (Cognito advanced security,
# AppSync introspection off, admin-password auth flow removed) to a branch that
# is not named main/production. Use for final pre-merge parity testing.
# WARNING: this removes ALLOW_ADMIN_USER_PASSWORD_AUTH, so `npm run
# test:integration` and `npm run verify:backend` stop working on that branch —
# which is exactly the production condition they cannot run against either.
# FORCE_SECURITY_HARDENING=1
