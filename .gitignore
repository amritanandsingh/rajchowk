# ---- AWS Amplify Gen 2 (MUST stay ignored) ----
# Contains User Pool ID, App Client ID, Identity Pool ID and the AppSync URL.
# Committing it makes Cognito enumeration trivial and it silently drifts
# between branches. `ampx sandbox` / `ampx pipeline-deploy` regenerate it.
amplify_outputs.json
amplify_outputs*.json
amplifyconfiguration*.json
.amplify/
/amplify/.amplify/

# ---- env / secrets (MUST stay ignored) ----
.env
.env.*
!.env.example
*.pem
*.key
.aws/
aws-exports.js

